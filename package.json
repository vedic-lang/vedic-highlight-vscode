{
  "name": "vedic",
  "publisher": "vedic",
  "displayName": "Vedic Code Formatter",
  "description": "Format Vedic source and run programs from Visual Studio Code using the Vedic CLI.",
  "version": "2.1.2",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:vedic",
    "onCommand:vedic.runFile",
    "onCommand:vedic.formatFile"
  ],
  "engines": {
    "vscode": "^1.66.0"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/vedic-lang"
  },
  "icon": "images/logo.png",
  "homepage": "https://github.com/vedic-lang/vedic-code-formatter",
  "keywords": [
    "vedic",
    "sanskrit",
    "devanagari",
    "formatter"
  ],
  "categories": [
    "Formatters"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedic-lang/vedic-code-formatter.git"
  },
  "author": {
    "name": "ptprashanttripathi",
    "email": "ptprashanttripathi@outlook.com",
    "url": "https://twitter.com/PtPrashant09"
  },
  "preview": false,
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "galleryBanner": {
    "color": "#ffdd00"
  },
  "license": "SEE LICENSE IN LICENSE",
  "pricing": "Free",
  "contributes": {
    "languages": [
      {
        "id": "vedic",
        "aliases": [
          "Vedic",
          "vedic"
        ],
        "extensions": [
          ".ved",
          ".v",
          ".veda",
          ".vedic"
        ]
      }
    ],
    "commands": [
      {
        "command": "vedic.runFile",
        "title": "Vedic: Run File",
        "icon": "$(play)"
      },
      {
        "command": "vedic.formatFile",
        "title": "Vedic: Format File",
        "icon": "$(code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vedic.runFile",
          "when": "editorTextFocus && resourceLangId == vedic",
          "group": "navigation@1"
        },
        {
          "command": "vedic.formatFile",
          "when": "editorTextFocus && resourceLangId == vedic",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Vedic",
      "properties": {
        "vedic.executable": {
          "type": "string",
          "default": "vedic",
          "description": "Path or command name of the Vedic CLI executable."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.1"
  }
}
