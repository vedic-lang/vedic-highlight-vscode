{
  "name": "vedic-syntax-highlighter",
  "publisher": "vedic",
  "displayName": "Vedic Language Tools",
  "description": "Vedic syntax highlighting, formatting, and run commands for Visual Studio Code.",
  "version": "2.1.0",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:vedic"
  ],
  "engines": {
    "vscode": "^1.66.0"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/vedic-lang"
  },
  "icon": "images/logo.png",
  "homepage": "https://github.com/vedic-lang/vedic-highlight-vscode",
  "keywords": [
    "vedic",
    "syntax",
    "highlighter",
    "code editor",
    "code",
    "editor",
    "vscode",
    "vscode-extension",
    "vscode-extensions",
    "vscode-extension-pack"
  ],
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedic-lang/vedic-highlight-vscode.git"
  },
  "author": {
    "name": "ptprashanttripathi",
    "email": "ptprashanttripathi@outlook.com",
    "url": "https://twitter.com/PtPrashant09"
  },
  "preview": false,
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "galleryBanner": {
    "color": "#ffdd00"
  },
  "license": "MIT",
  "pricing": "Free",
  "contributes": {
    "languages": [
      {
        "id": "vedic",
        "aliases": [
          "vedic",
          "vedic"
        ],
        "extensions": [
          ".ved",
          ".v",
          ".veda",
          ".vedic"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vedic",
        "scopeName": "source.vedic",
        "path": "./syntaxes/vedic.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "vedic.runFile",
        "title": "Vedic: Run File",
        "icon": "$(play)"
      },
      {
        "command": "vedic.formatFile",
        "title": "Vedic: Format File",
        "icon": "$(code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vedic.runFile",
          "when": "editorTextFocus && resourceLangId == vedic",
          "group": "navigation@1"
        },
        {
          "command": "vedic.formatFile",
          "when": "editorTextFocus && resourceLangId == vedic",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Vedic",
      "properties": {
        "vedic.executable": {
          "type": "string",
          "default": "vedic",
          "description": "Path or command name of the Vedic CLI executable."
        }
      }
    }
  }
}
